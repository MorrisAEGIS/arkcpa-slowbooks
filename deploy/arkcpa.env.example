# Runtime binding. Stage on 3334; production uses 3333.
APP_PUBLISH_PORT=3334
APP_WORKERS=2

# Database identity. Use generated secrets in the ignored root .env file.
POSTGRES_USER=arkcpa
POSTGRES_PASSWORD=replace-with-generated-secret
POSTGRES_DB=arkcpa

# Application secrets. Generate each independently.
PAYROLL_ENCRYPTION_SECRET=replace-with-generated-secret
SESSION_SECRET_KEY=replace-with-generated-secret
SETTINGS_ENCRYPTION_KEY=replace-with-fernet-key

# Browser origins served by the existing Cloudflare tunnel.
CORS_ALLOW_ORIGINS=https://arkcpa.magaenergy.ai,https://arkaccounting.magaenergy.ai,https://cpa.magaenergy.ai
SESSION_IDLE_TIMEOUT_SECONDS=14400

# Native ARK identity login. Provision with deploy/provision_authentik_oidc.py.
AUTHENTIK_OIDC_ENABLED=true
AUTHENTIK_OIDC_ISSUER=https://auth.magaenergy.ai/application/o/arkcpa/
AUTHENTIK_OIDC_CLIENT_ID=replace-with-provisioned-client-id
AUTHENTIK_OIDC_CLIENT_SECRET=replace-with-provisioned-client-secret
AUTHENTIK_OIDC_REDIRECT_URI=https://arkcpa.magaenergy.ai/api/auth/authentik/callback
AUTHENTIK_OIDC_SCOPES=openid profile email
AUTHENTIK_OIDC_REQUIRED_GROUP=ArkCPA Owners
AUTHENTIK_OIDC_BOOTSTRAP_EMAIL=owner@example.com

# One Ark CPA UI, multiple authenticated people, and one isolated database per
# legal entity. Access is checked against the central control database on every
# entity selection; a browser cookie or X-Ark-Entity header is never trusted.
COMPOSE_PROJECT_NAME=arkcpa-slowbooks
ARKCPA_WORKSPACE_ID=arkcpa
ARKCPA_WORKSPACE_LABEL=Multi-entity books
ARKCPA_PUBLIC_HOSTNAME=arkcpa.magaenergy.ai
ARKCPA_ENTITY_MODE=true
ARK_FILES_ROOT_HOST=/home/novaadmin/ark-files
ARKCPA_MAX_EVIDENCE_BYTES=52428800
ARKCPA_MAX_SCAN_FILES=10000

# Internal OpenAI-compatible ARK gateway. The Bookkeeper and Controller routes
# must resolve to different model families. Raw documents are never sent.
ARKCPA_AI_BASE_URL=http://host.docker.internal:4000/v1
ARKCPA_AI_API_KEY=replace-with-internal-gateway-key
ARKCPA_AI_ALLOWED_HOSTS=litellm,host.docker.internal,127.0.0.1,localhost
ARKCPA_BOOKKEEPER_MODEL=ark-coder-oss
ARKCPA_BOOKKEEPER_FAMILY=gpt-oss
ARKCPA_CONTROLLER_MODEL=ark-brain
ARKCPA_CONTROLLER_FAMILY=nemotron3-super
ARKCPA_REQUIRE_GATEWAY_FAMILY_PROOF=true
ARKCPA_AI_TIMEOUT_SECONDS=60

# The controller-worker is an explicit Compose profile. Begin with posting and
# external tax refresh disabled. Enable each only after its separate proof gate.
ARKCPA_CONTROLLER_INTERVAL_SECONDS=900
ARKCPA_CONTROLLER_MAX_CANDIDATES=25
ARKCPA_CONTROLLER_ALLOW_POSTING=false
ARKCPA_CONTROLLER_REFRESH_TAX=false
ARKCPA_TAX_SOURCE_HOSTS=
COMPANY_NAME=My Company
EMPLOYER_STATE=WA
SUTA_RATE=0.012
