# Runtime binding. Stage on 3334; production uses 3333.
APP_PUBLISH_PORT=3334
APP_WORKERS=2

# Database identity. Use generated secrets in the ignored root .env file.
POSTGRES_USER=arkcpa
POSTGRES_PASSWORD=replace-with-generated-secret
POSTGRES_DB=arkcpa

# Application secrets. Generate each independently.
PAYROLL_ENCRYPTION_SECRET=replace-with-generated-secret
SESSION_SECRET_KEY=replace-with-generated-secret
SETTINGS_ENCRYPTION_KEY=replace-with-fernet-key

# Browser origins served by the existing Cloudflare tunnel.
CORS_ALLOW_ORIGINS=https://arkcpa.magaenergy.ai,https://arkaccounting.magaenergy.ai,https://cpa.magaenergy.ai
SESSION_IDLE_TIMEOUT_SECONDS=14400

# Native ARK identity login. Provision with deploy/provision_authentik_oidc.py.
AUTHENTIK_OIDC_ENABLED=true
AUTHENTIK_OIDC_ISSUER=https://auth.magaenergy.ai/application/o/arkcpa/
AUTHENTIK_OIDC_CLIENT_ID=replace-with-provisioned-client-id
AUTHENTIK_OIDC_CLIENT_SECRET=replace-with-provisioned-client-secret
AUTHENTIK_OIDC_REDIRECT_URI=https://arkcpa.magaenergy.ai/api/auth/authentik/callback
AUTHENTIK_OIDC_SCOPES=openid profile email
AUTHENTIK_OIDC_REQUIRED_GROUP=ARK Family
COMPANY_NAME=My Company
EMPLOYER_STATE=WA
SUTA_RATE=0.012
