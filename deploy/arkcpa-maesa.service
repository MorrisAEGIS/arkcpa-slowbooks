[Unit]
Description=Maesa private ArkCPA SlowBooks workspace
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/novaadmin/arkcpa-slowbooks
ExecStart=/usr/bin/docker compose --env-file /home/novaadmin/.config/arkcpa/workspaces/maesa.env -f docker-compose.ark.yml up -d --no-build --wait --wait-timeout 180
ExecStop=/usr/bin/docker compose --env-file /home/novaadmin/.config/arkcpa/workspaces/maesa.env -f docker-compose.ark.yml stop
TimeoutStartSec=240
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
